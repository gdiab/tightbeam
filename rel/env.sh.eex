#!/bin/sh
# Core fix (A), C21.1: no alternate route into the running gateway.
#
# By default the production gateway runs WITHOUT Erlang distribution: no node name,
# no EPMD started, no distribution listener on any interface. A distributed node lets
# any process holding the cookie run code inside the gateway, past every
# authorization gate, and on a shared account every agent can read any cookie file.
# Nothing in production needs distribution: `stop` signals the owned pid, and the
# gateway's `:global.trans` locks are node-local. The package carries no cookie
# (`releases/COOKIE` is removed at assembly), so the value set here is a throwaway
# that nothing uses.
#
# Debug distribution exists only by editing the installed service's environment by
# hand: TIGHTBEAM_DEBUG_DISTRIBUTION=loopback. Then the node, the distribution
# listener and any EPMD it starts are on 127.0.0.1 only, and the cookie is this
# install's own, generated at first start in $TIGHTBEAM_BASE_DIR with 256 random
# bits, mode 0600, owned by the gateway's account. Every process of that account can
# read it, so this reopens a route equal to editing state.db directly; turn it off
# again when done.
#
# This file is sourced before the launcher applies its defaults, so these values win
# over any inherited RELEASE_DISTRIBUTION, RELEASE_NODE or RELEASE_COOKIE.

tb_random_hex() {
  dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

case "${TIGHTBEAM_DEBUG_DISTRIBUTION:-}" in
  "")
    RELEASE_DISTRIBUTION=none
    RELEASE_COOKIE="$(tb_random_hex)"
    ;;

  loopback)
    if [ -z "${TIGHTBEAM_BASE_DIR:-}" ]; then
      echo "tightbeam: TIGHTBEAM_DEBUG_DISTRIBUTION needs TIGHTBEAM_BASE_DIR for its cookie." >&2
      exit 1
    fi

    tb_cookie_file="$TIGHTBEAM_BASE_DIR/debug-distribution.cookie"

    if [ ! -e "$tb_cookie_file" ]; then
      (umask 077 && tb_random_hex > "$tb_cookie_file") || exit 1
    fi

    if [ -z "$(find "$tb_cookie_file" -maxdepth 0 -type f -user "$(id -u)" -perm 600 2>/dev/null)" ]; then
      echo "tightbeam: $tb_cookie_file must be a regular file of this account with mode 0600." >&2
      exit 1
    fi

    RELEASE_DISTRIBUTION=name
    RELEASE_NODE="tightbeam_gateway_${TIGHTBEAM_PORT:-11373}@127.0.0.1"
    RELEASE_COOKIE="$(cat "$tb_cookie_file")"
    ERL_EPMD_ADDRESS=127.0.0.1
    ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }-kernel inet_dist_use_interface {127,0,0,1}"
    export RELEASE_NODE ERL_EPMD_ADDRESS ELIXIR_ERL_OPTIONS
    ;;

  *)
    echo "tightbeam: TIGHTBEAM_DEBUG_DISTRIBUTION accepts only 'loopback'." >&2
    exit 1
    ;;
esac

export RELEASE_DISTRIBUTION RELEASE_COOKIE
