#!/bin/sh
# Core fix (A), C21: no alternate route into the running gateway.
#
# Mix's launcher (bin/tightbeam_gateway) sources this file for EVERY command, after it
# reads its own location and before it applies any default or runs anything. So the
# rules here hold whether the release is reached through the packaged
# `tightbeam-gateway` or directly.
#
# 1. Commands (C21.2). Only `start` and `version` run. Every other release command
#    (start_iex, daemon, daemon_iex, eval, rpc, remote, restart, stop, pid, ...) can
#    give a shell, run code or need distribution, and is refused.
#
# 2. Inputs (C21.1). Nothing the caller's environment carries may reach the VM's flags:
#    every ERL_* and ELIXIR_* variable is dropped, and every RELEASE_* setting the
#    launcher reads after this file is fixed below. (RELEASE_ROOT, RELEASE_NAME,
#    RELEASE_VSN and RELEASE_PROG are read before this file. The packaged launcher
#    clears them; a caller who sets RELEASE_VSN on the raw launcher is choosing which
#    files to run, which is running code of their own.)
#
# 3. Distribution (C21.1). Off: no node name, no EPMD started, no distribution
#    listener. The package carries no cookie (releases/COOKIE is removed at assembly);
#    RELEASE_COOKIE is a throwaway nothing uses. Debug distribution exists only by
#    editing the installed service's environment by hand:
#    TIGHTBEAM_DEBUG_DISTRIBUTION=loopback:<port>. The node then listens only on
#    127.0.0.1:<port>, registers with no EPMD (Tightbeam.DebugEpmd), and uses this
#    install's own cookie, generated at first start in $TIGHTBEAM_BASE_DIR with 256
#    random bits, mode 0600, owned by the gateway's account. Every process of that
#    account can read it, so this reopens a route equal to editing state.db directly;
#    remove the setting when done.

tb_refuse() {
  printf 'tightbeam_gateway: %s\n' "$1" >&2
  exit "${2:-64}"
}

case "${RELEASE_COMMAND:-}" in
  start | version) ;;
  *)
    tb_refuse "\`${RELEASE_COMMAND:-}\` is not available (C21.2): the gateway offers no route into the running node. Use the routed interfaces: the tightbeam CLI and Chat."
    ;;
esac

tb_random_hex() {
  dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n'
}

# Drop every Erlang and Elixir flag channel the caller's environment offers.
for tb_var in $(env | sed -n 's/^\(ERL_[A-Za-z0-9_]*\)=.*/\1/p; s/^\(ELIXIR_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$tb_var"
done

# Fix every launcher setting read after this file.
RELEASE_NAME=tightbeam_gateway
RELEASE_MODE=embedded
RELEASE_TMP="$RELEASE_ROOT/tmp"
RELEASE_VM_ARGS="$REL_VSN_DIR/vm.args"
RELEASE_REMOTE_VM_ARGS="$REL_VSN_DIR/remote.vm.args"
RELEASE_BOOT_SCRIPT=start
RELEASE_BOOT_SCRIPT_CLEAN=start_clean
RELEASE_NODE=tightbeam_gateway
unset RELEASE_SYS_CONFIG
export RELEASE_NAME RELEASE_MODE RELEASE_TMP RELEASE_VM_ARGS RELEASE_REMOTE_VM_ARGS
export RELEASE_BOOT_SCRIPT RELEASE_BOOT_SCRIPT_CLEAN RELEASE_NODE

case "${TIGHTBEAM_DEBUG_DISTRIBUTION:-}" in
  "")
    RELEASE_DISTRIBUTION=none
    RELEASE_COOKIE="$(tb_random_hex)"
    ;;

  loopback:*)
    tb_port="${TIGHTBEAM_DEBUG_DISTRIBUTION#loopback:}"

    case "$tb_port" in
      "" | *[!0-9]*) tb_refuse "TIGHTBEAM_DEBUG_DISTRIBUTION must be loopback:<port>." 1 ;;
    esac

    if [ "$tb_port" -lt 1024 ] || [ "$tb_port" -gt 65535 ]; then
      tb_refuse "TIGHTBEAM_DEBUG_DISTRIBUTION's port must be 1024-65535." 1
    fi

    if [ -z "${TIGHTBEAM_BASE_DIR:-}" ]; then
      tb_refuse "TIGHTBEAM_DEBUG_DISTRIBUTION needs TIGHTBEAM_BASE_DIR for its cookie." 1
    fi

    tb_cookie_file="$TIGHTBEAM_BASE_DIR/debug-distribution.cookie"

    if [ ! -e "$tb_cookie_file" ]; then
      (umask 077 && tb_random_hex > "$tb_cookie_file") || exit 1
    fi

    if [ -z "$(find "$tb_cookie_file" -maxdepth 0 -type f -user "$(id -u)" -perm 600 2>/dev/null)" ]; then
      tb_refuse "$tb_cookie_file must be a regular file of this account with mode 0600." 1
    fi

    # Only a cookie this branch generated: 64 lowercase hex characters (256 bits).
    RELEASE_COOKIE="$(cat "$tb_cookie_file")"

    case "$RELEASE_COOKIE" in
      *[!0-9a-f]*) tb_refuse "$tb_cookie_file must hold 64 hex characters; remove it to regenerate." 1 ;;
    esac

    if [ "${#RELEASE_COOKIE}" -ne 64 ]; then
      tb_refuse "$tb_cookie_file must hold 64 hex characters; remove it to regenerate." 1
    fi

    RELEASE_DISTRIBUTION=name
    RELEASE_NODE="tightbeam_gateway_${TIGHTBEAM_PORT:-11373}@127.0.0.1"
    ELIXIR_ERL_OPTIONS="-start_epmd false -epmd_module Elixir.Tightbeam.DebugEpmd -kernel erl_epmd_node_listen_port $tb_port -kernel inet_dist_use_interface {127,0,0,1}"
    export ELIXIR_ERL_OPTIONS
    ;;

  *)
    tb_refuse "TIGHTBEAM_DEBUG_DISTRIBUTION accepts only loopback:<port>." 1
    ;;
esac

export RELEASE_DISTRIBUTION RELEASE_COOKIE
