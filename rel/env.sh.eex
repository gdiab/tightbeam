#!/bin/sh
## Option 2 (PO att_7b3c25f9, att_98019d3a): every release command (start, rpc,
## remote, eval, ...) takes the Erlang cookie from exactly one owner-only file,
## chosen when the package was assembled (releases/COOKIE_MODE, written by the
## release step in mix.exs). An inherited RELEASE_COOKIE never wins, and there is
## no fallback between the modes: a missing or loose file stops the command.
##   per-install: the build root's COOKIE, outside the hashed package
##                (<build root>/tightbeam/release is RELEASE_ROOT).
##   per-build:   the package's own releases/COOKIE.
## The cookie's value is never printed.

tb_cookie_refuse() {
  printf 'tightbeam: refusing to run: %s\n' "$1" >&2
  exit 78
}

tb_cookie_mode_file="$RELEASE_ROOT/releases/COOKIE_MODE"
if [ -L "$tb_cookie_mode_file" ] || [ ! -f "$tb_cookie_mode_file" ]; then
  tb_cookie_refuse "releases/COOKIE_MODE is missing or not a regular file"
fi

case "$(cat "$tb_cookie_mode_file")" in
  per-install) tb_cookie_file="$RELEASE_ROOT/../../COOKIE" ;;
  per-build) tb_cookie_file="$RELEASE_ROOT/releases/COOKIE" ;;
  *) tb_cookie_refuse "releases/COOKIE_MODE names no known cookie mode" ;;
esac

if [ -L "$tb_cookie_file" ]; then
  tb_cookie_refuse "the cookie file $tb_cookie_file is a symlink"
fi
if [ ! -f "$tb_cookie_file" ]; then
  tb_cookie_refuse "the cookie file $tb_cookie_file is missing or not a regular file"
fi

# GNU stat first (Linux), BSD stat otherwise (macOS).
tb_cookie_stat="$(stat -c '%u %a' "$tb_cookie_file" 2>/dev/null || stat -f '%u %Lp' "$tb_cookie_file" 2>/dev/null)"
if [ "${tb_cookie_stat%% *}" != "$(id -u)" ]; then
  tb_cookie_refuse "the cookie file $tb_cookie_file is not owned by the running user"
fi
if [ "${tb_cookie_stat#* }" != "600" ]; then
  tb_cookie_refuse "the cookie file $tb_cookie_file is not mode 0600"
fi

RELEASE_COOKIE="$(cat "$tb_cookie_file")"
if [ "${#RELEASE_COOKIE}" -lt 32 ]; then
  unset RELEASE_COOKIE
  tb_cookie_refuse "the cookie in $tb_cookie_file is shorter than 32 bytes"
fi
export RELEASE_COOKIE
unset tb_cookie_mode_file tb_cookie_file tb_cookie_stat
