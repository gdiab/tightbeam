#!/bin/sh
# Core fix (A), review B1: the production gateway runs WITHOUT Erlang distribution.
#
# A distributed node lets anything that holds the release cookie run code inside the
# live gateway (`rpc`, `remote`), which would bypass every authorization gate, and the
# packaged cookie ships inside a public artifact. Nothing in production needs
# distribution: `stop` signals the owned pid, and the gateway's `:global.trans` locks
# are node-local. So no node name is registered with epmd, no distribution port
# listens, and `rpc`/`remote` have nothing to reach.
#
# This file is sourced before the launcher applies its defaults, so these values win
# over any inherited RELEASE_DISTRIBUTION or RELEASE_COOKIE. The cookie is a fresh
# random value per start, never the one baked into the package.
RELEASE_DISTRIBUTION=none
export RELEASE_DISTRIBUTION
RELEASE_COOKIE="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
export RELEASE_COOKIE
